# Salin menjadi .env.local lalu isi. JANGAN commit .env.local.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Hanya dipakai di server (cron, endpoint e-Pusluh, skrip ETL). Jangan pernah ke browser.
SUPABASE_SERVICE_ROLE_KEY=

# Domain email sintetis untuk login NIP (NIP@domain). Tidak pernah ditampilkan ke user.
AUTH_EMAIL_DOMAIN=smartltt.local

# (Bot VPS & aplikasi luar memakai kunci API dari menu Akses API, bukan env di sini.)

# Webhook VPS (bot WA). Fitur saran dihapus 16 Nov 2026.
VPS_WEBHOOK_URL=http://103.245.38.96:3000
VPS_WEBHOOK_SECRET=

# Push notifikasi PWA. Buat dengan: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@smartltt.local
# Rahasia Vercel Cron (/api/cron/*). Isi string acak panjang; Vercel mengirimnya sebagai Bearer token.
CRON_SECRET=
