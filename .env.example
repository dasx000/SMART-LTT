# Salin menjadi .env.local lalu isi. JANGAN commit .env.local.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Hanya dipakai di server (cron, endpoint e-Pusluh, skrip ETL). Jangan pernah ke browser.
SUPABASE_SERVICE_ROLE_KEY=

# Domain email sintetis untuk login NIP (NIP@domain). Tidak pernah ditampilkan ke user.
AUTH_EMAIL_DOMAIN=smartltt.local

# Token untuk bot VPS saat mengirim data padi ke /api/epusluh/sinkron-padi
EPUSLUH_INGEST_TOKEN=

# Webhook VPS (saran & bot WA)
VPS_WEBHOOK_URL=http://103.245.38.96:3000
VPS_WEBHOOK_SECRET=
